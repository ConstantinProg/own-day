{
  "InboxAnalysis": {
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-4.1-mini",
      "MaxOutputTokens": 4096,
      "TimeoutSeconds": 60
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
