{
  "InboxAnalysis": {
    "Background": {
      "Enabled": false,
      "Parallelism": 1,
      "PollSeconds": 5,
      "LeaseSeconds": 120,
      "TimeoutSeconds": 60,
      "MaxAttempts": 3,
      "InitialBackoffSeconds": 30,
      "MaxBackoffSeconds": 900
    },
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-6-luna",
      "ReasoningEffort": "low",
      "MaxOutputTokens": 8192,
      "TimeoutSeconds": 60
    },
    "CostControl": {
      "TokenLimit": null,
      "TokensPerRequest": 100000,
      "MonthlyUsdLimit": 10,
      "MonthlyCallLimit": 10000,
      "MonthlyUserCallLimit": 1000,
      "MonthlyTokenLimit": 20000000,
      "MonthlyUserTokenLimit": 2000000,
      "Models": {
        "gpt-6-luna": {
          "InputUsdPerMillion": 0.10,
          "CachedInputUsdPerMillion": 0.01,
          "OutputUsdPerMillion": 0.50
        }
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
