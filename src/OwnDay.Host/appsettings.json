{
  "InboxAnalysis": {
    "Background": {
      "Enabled": true,
      "Parallelism": 1,
      "PollSeconds": 5,
      "LeaseSeconds": 120,
      "TimeoutSeconds": 60,
      "MaxAttempts": 3,
      "InitialBackoffSeconds": 30,
      "MaxBackoffSeconds": 900
    },
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-6-luna",
      "ReasoningEffort": "low",
      "MaxOutputTokens": 8192,
      "TimeoutSeconds": 60
    },
    "CostControl": {
      "TokenLimit": 1000000,
      "TokensPerRequest": 100000,
      "Models": {}
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
